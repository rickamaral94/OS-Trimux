files.file.desc = %s\nSize: %s\nModified on %s
files.delete.hint = A: delete (asks first) · B: up one folder
files.protected = TriMux or official system folder: read-only, so the system cannot be broken.
files.delete = Delete file
files.delete.confirm = Delete "%s" (%s)? This cannot be undone.
files.deleted = File deleted
files.delete.failed = The file could not be deleted

web.needs_wifi = Connect to Wi-Fi first (Settings › Network).
web.failed = The file server could not be started. See the Log.
web.running = On a computer or phone on the same Wi-Fi, open in the browser:\n\nhttp://%s:%d\n\nNo password: any device on this network can see and change the files while this window is open. The device does not power off by itself while it is open.\n\nA or B: close and stop the server.
emu.ppsspp.note = PlayStation Portable. No BIOS needed: the PSP system fonts and files come with TriMux (Bios/PPSSPP). Games in .iso, .cso, .chd or .pbp (.cso takes less space). 2D and light games run well; heavy 3D games may slow down at 2x resolution.
covers.systems = PLATFORMS TO DOWNLOAD
covers.system.desc = %s: %zu games.\n\nA: turn on or off. Platforms turned off are left out of the cover download (manual and automatic), so you can get what you want first. Covers already downloaded keep showing.
covers.waiting = %d of %d: waiting for the Wi-Fi to come back…
home.last_played = Last played
settings.animations = Animations
settings.animations.desc = The selection glides between items and the background colour follows the chosen platform. Turn off for a plainer menu (uses slightly less battery in the menu).
view.title = Show games as
view.list = List
view.grid = Cover grid
view.desc = List: names with the cover in the side panel. Cover grid: 10 covers per screen (5 × 2), great once covers are downloaded; games without a cover show as a card in the platform colour. In both, A plays, X favourites and START opens the options; in the grid, the d-pad moves around and L1/R1 change page.
