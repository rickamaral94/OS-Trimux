diag.measure = Measurement
diag.perf = Performance log in games
diag.perf.desc = During each game, records every 10 s the CPU frequency, the limit in force, temperature and battery, and a session summary at the end. Files in TriMuxData/logs/perf (open in a spreadsheet). Use it to compare profiles, 2.0 GHz and emulators. When off, nothing is written.
diag.fps = Show FPS in games
diag.fps.desc = Shows frames per second in a corner of the screen during the game (a RetroArch feature). Useful to check that a more economical profile still runs at full speed.
diag.sessions = Recorded sessions
diag.sessions.desc = Summary per profile (temperature, battery drain, CPU) and the list of the latest sessions.
diag.sessions.none = No sessions recorded. Turn the performance log on and play for a few minutes.
diag.by_profile = Summary per profile
diag.recent = Sessions (newest first)
diag.profile.desc = Recorded sessions: %d. Average maximum temperature: %s. Average battery drain: %s (sessions counted: %d, only those of 5 min or more without charger). Average CPU: %s.
diag.viewlog = View TriMux log
diag.session.desc = Emulator: %s. Profile: %s. Average CPU %s (max %s). Temperature: %s at start, max %s, %s at the end. Battery: %s → %s%s. Thermal protection triggered %d time(s).
diag.charging = charging
diag.technical = Technical logs
diag.verbose = Detailed TriMux log
diag.verbose.desc = Writes more detail to TriMuxData/logs/trimux.log (capped at 256 KB + 1 copy). Turn on only to investigate a problem.
diag.ralog = RetroArch log
diag.ralog.desc = RetroArch writes its own log to TriMuxData/logs/retroarch/retroarch.log, replaced on every game. Helps understand a game that does not start or closes by itself.
diag.clear = Delete performance logs
diag.clear.desc = Deletes the recorded sessions and the RetroArch log. Does not touch games, saves or settings.
diag.clear.confirm = Delete all recorded sessions and the RetroArch log?
diag.cleared = %d files deleted

# Game covers
covers.title = Game covers
covers.desc = Downloads covers from the internet (libretro-thumbnails, free, no account) and shows them in the game list.
covers.run = Download covers now
covers.stop = Stop the download
covers.run.desc = Downloads the missing covers in the background: you can keep using the menu and even play (the download pauses during games). Needs Wi-Fi. Covers are saved as Imgs/<folder>/<game>.png, the folder the stock system uses.
covers.status = Status
covers.status.desc = Matching is by file name: games named in the No-Intro style (e.g. "Celeste Classic (World).gba") are found more easily. Arcade uses the FinalBurn Neo title list. If the device restarts during an automatic download, it does not start again by itself until the next boot; use Download covers now to continue.
covers.retry = Retry games not found
covers.retry.desc = Games without a cover on the first search are not searched again automatically. Use after renaming files.
covers.options = Options
covers.show = Show covers in the list
covers.show.desc = Shows the cover in the selected game's panel. Also works for images you copy to Imgs/.
covers.kind = Image type
covers.kind.desc = Box art, an in-game screen or the title screen. Applies to the next downloads.
covers.kind.boxart = Box art
covers.kind.snap = In-game screen
covers.kind.title = Title screen
covers.auto = Automatic covers
covers.auto.desc = With Wi-Fi connected, downloads covers for new games by itself: at startup, after reindexing the library and when connecting to a network.
covers.progress = %d of %d (%d found)
covers.done = %d downloaded, %d not found
covers.state.none = No download yet
covers.state.running = Downloading…
covers.state.stopped = Stopped
covers.state.nowifi = No Wi-Fi
covers.state.network = Network error, try later
covers.state.error = Error
covers.state.interrupted = Unfinished: the device restarted
covers.needs_wifi = Connect to a Wi-Fi network first (Settings › Network).
covers.started = Cover download started
covers.stopping = Stopping after the current cover…
update.title = Update
update.desc = Updates TriMux over the internet, without flashing the card again. Games, saves and settings stay as they are.
update.installed = Installed version
update.installed.desc = TriMux version on this card.
update.status = Status
update.status.desc = Versions come from the project's GitHub releases page. The package is verified (SHA-256) before it is installed.
update.check = Check for updates
update.check.desc = Checks whether a newer version exists. Needs Wi-Fi. Nothing is downloaded until you confirm.
update.install = Install
update.install.confirm = Download and install version %s?\n\nOnly the TriMux and trimui folders are replaced; games, BIOS, saves, covers and settings are not changed. The current version is kept so you can go back. Keep the device on (battery above 30%% or charging).
update.prerelease_note = Pre-release (test version).
update.no_notes = No release notes.
update.reboot = Reboot to finish
update.reboot.desc = The new version takes effect after a reboot. If it does not reach the menu in 3 attempts, the previous version comes back by itself.
update.ready.text = Version %s installed. Reboot now to use it?
update.options = Options
update.prerelease = Include pre-releases
update.prerelease.desc = Also offers test versions. Every TriMux version so far is a pre-release.
update.auto = Check at power-on
update.auto.desc = At power-on, with Wi-Fi, checks for a new version and tells you in the menu. Never installs by itself.
update.rollback = Go back to the previous version
update.rollback.desc = Switches to the version kept by the last update and reboots.
update.rollback.confirm = Go back to the previous TriMux version and reboot? Games, saves and settings are not changed.
update.rollback.failed = Could not go back to the previous version
update.needs_wifi = Connect to a Wi-Fi network first (Settings › Network).
update.launch_blocked = An update is being installed or waits for a reboot. Wait for it to finish and reboot to play.
update.toast = New TriMux version available: %s (Settings › System › Update)
update.state.none = Not checked yet
update.state.checking = Checking…
update.state.uptodate = You have the newest version
update.state.available = Version %s available
update.state.downloading = Downloading… %d%%
update.state.installing = Installing…
update.state.ready = Version %s installed, reboot
update.err.nowifi = No Wi-Fi
update.err.network = Network error, try again later
update.err.badreply = Unexpected reply from GitHub, try again later
update.err.notnewer = The offered version is not newer than the installed one
update.err.battery = Battery below 30%: connect the charger
update.err.space = Not enough free space on the card
update.err.checksum = The downloaded package does not match (SHA-256); nothing was changed
update.err.write = Could not write to the card; the current version was kept
update.err.package = Incomplete package or a different version; nothing was changed
update.err.interrupted = The last attempt was interrupted; nothing was changed
update.err.unknown = Error

leds.power = Lights
leds.power.on = On
leds.power.off = Off
leds.power.desc = Turns every light off or on right away; they stay that way in the menu and in games. Same as the F1/F2 "LEDs" action.
leds.managed.trimux = TriMux (custom)
leds.managed.stock = TrimUI default
time.title = Date and time
time.desc = Clock, time zone and automatic setting over the internet.
time.now = Now
time.now.desc = Current date and time in the chosen zone.
time.zone = Time zone
time.zone.stock = The stock system's
time.zone.desc = Use ◀ ▶. Applies to the menu, games and apps. "The stock system's" uses the zone chosen in the TrimUI settings.
time.ntp = Set over the internet
time.ntp.desc = With Wi-Fi connected, sets the clock over the internet at power-on.
time.sync = Set now over the internet
time.sync.desc = Gets the right time now (needs Wi-Fi).
time.sync.started = Setting the clock over the internet…
time.needs_wifi = Connect to a Wi-Fi network first (Settings › Network).
time.manual = Manual setting
time.day = Day
time.month = Month
time.year = Year
time.hour = Hour
time.minute = Minute
time.field.desc = Use ◀ ▶ to change, then choose "Apply date and time".
time.apply = Apply date and time
time.apply.desc = Sets the device clock to the values above. Kept when the device is off.
time.applied = Date and time set
time.apply_failed = Could not set the date and time
apps.title = Apps
apps.desc = Apps installed in the TrimUI format (Apps folder on the card, apps on the internal memory and the system's own), apart from the games.
apps.none = No apps found
apps.none.desc = Install one from the store below, or put apps in the TrimUI format (a folder with config.json and launch.sh) in Apps/ on the card.
apps.builtin = App from the stock TrimUI system.
apps.installed = Installed app.
osd.volume = Volume
osd.brightness = Brightness
leds.all = All lights
leds.all.desc = Color, brightness and effect for every light at once. Each one can still be adjusted separately below.

# Game picture (Settings › Emulators)
video.all = Picture for all platforms
video.all.desc = Choose the screen shape and look of every game at once. Each platform can still be adjusted on its own below.
video.mixed = Mixed
video.mixed.desc = Platforms have different choices. Changing it here sets the same on all of them.
video.header = GAME PICTURE
video.header.desc = How games of this platform look on screen. Applies from the next game you open.
video.aspect = Screen shape
video.aspect.desc = Use ◀ ▶ to change.
video.aspect.original = Original
video.aspect.original.desc = Original: the console's own shape, as large as the screen allows. Recommended.
video.aspect.integer = Perfect pixels
video.aspect.integer.desc = Perfect pixels: every pixel the same size, no distortion. The picture is a bit smaller, with black borders.
video.aspect.full = Full screen
video.aspect.full.desc = Full screen: stretched to fill the whole screen. Characters may look wider or taller.
video.filter = Look
video.filter.desc = Use ◀ ▶ to change. The effects are light and were chosen for the Brick Pro's graphics chip.
video.filter.sharp = Sharp
video.filter.sharp.desc = Sharp: square pixels, no effect, as the game was drawn.
video.filter.smooth = Smooth
video.filter.smooth.desc = Smooth: slightly blurred to hide the blocks. Text may look softer.
video.filter.pixel = Smooth pixels
video.filter.pixel.desc = Smooth pixels: keeps pixels crisp but without jagged edges when the picture is enlarged. Good for almost every 2D game.
video.filter.lcd = LCD screen
video.filter.lcd.desc = LCD screen: imitates the dot grid of a handheld screen, like the Game Boy and Game Gear.
video.filter.crt = Old TV
video.filter.crt.desc = Old TV: lines and glow of a tube TV, the way home consoles were seen.
video.filter.tip.handheld = Suggested for this platform: LCD screen or Smooth pixels.
video.filter.tip.tv = Suggested for this platform: Old TV or Smooth pixels.
video.filter.tip.all = Handhelds (Game Boy, Game Gear…) usually look best with LCD screen; home consoles with Old TV.
video.res = Internal resolution
video.res.native = Original
video.res.2x = 2x (sharper)
video.res.3x = 3x (maximum)
video.res.screen = Same as screen (1024×768)
video.res.desc = Draws the game with more pixels: models and edges look sharper. Higher is heavier. Applies when the game opens.
video.res.desc.ps = Draws PlayStation 3D graphics with twice the pixels: models and edges look sharper. Much heavier; if a game slows down, go back to Original. 2D screens and videos do not change.
video.res.none = Not available
video.res.none.desc = Games of this platform are 2D and already use the console's resolution. To make them look nicer, use the Look setting (Smooth pixels, LCD screen or Old TV).
video.colors = Original handheld colours
video.colors.desc = Adjusts colours to look like the original handheld's screen, less saturated. Off shows pure, stronger colours.
video.ghost = LCD trail
video.ghost.desc = Imitates the slight trail of old LCD screens. Some games need it for transparency and to stop objects flickering (e.g. F-Zero, Wave Race).
video.hd = HD textures
video.hd.desc = Replaces the graphics with high-resolution versions when the game has an HD pack (Mesen HD Pack format).\n\nHow to use: put the pack folder in Bios/HdPacks/<game file name, without extension>/ with its hires.txt inside. Works best with the game as .nes (not inside a .zip). Packs are not included with TriMux.\n\nPacks found on the card: %d.
game.image = Platform picture
game.image.desc = Screen shape, look (LCD, old TV…), resolution and textures for this platform's games.

# Game order
sort.title = Game order
sort.desc = How game lists are ordered. Use ◀ ▶ to change. Applies to every platform.
sort.name = Name (A–Z)
sort.name.desc = Name (A–Z): alphabetical, as always.
sort.popular = Popularity
sort.popular.desc = Popularity: the platform's best-selling games first, from public sales lists (Wikipedia). Games not in the list come after, alphabetically. Games are recognised by file name (No-Intro style, e.g. Super Mario World (USA).sfc).
sort.played = Most played
sort.played.desc = Most played: the games you spent most time in first. Counted on the device, for every game open longer than 10 seconds. Games never opened come after, alphabetically.
games.rank = No. %d among the best-selling %s games
games.played_h = Played %ld times · %ld h %02ld min
games.played_m = Played %ld times · %ld min

# App store (Apps)
store.header = APP STORE
store.install = Install
store.installed = Installed
store.downloading = Downloading %d%%
store.installing = Installing…
store.info = %s\n\nVersion %s · %ld MB\nLicense: %s\n%s\n\n%s Downloaded straight from the project and checked (SHA-256) before writing.
store.system.no = Only uses the card.
store.system.yes = Only uses the card; while open it adjusts the CPU (back to normal on exit).
store.install.confirm = Download and install %s %s (%ld MB) over Wi-Fi?\n\nThe file is checked before anything on the card changes. Games, saves and settings are not touched.
store.remove.confirm = Remove %s from the card?\n\nOnly the app's own files are deleted. What you created with it (installed ports, for example) stays.
store.needs_wifi = Connect to a Wi-Fi network to install (Settings › Network).
store.done = App installed
store.failed = The installation did not finish (see why in the store)
store.err.nowifi = Not finished: no Wi-Fi.
store.err.space = Not finished: not enough space on the card.
store.err.battery = Not finished: battery below 20%. Plug in the charger.
store.err.network = Not finished: the download failed. Try again.
store.err.checksum = Not finished: the downloaded file does not match (SHA-256). Nothing was written.
store.err.package = Not finished: the package is not in the expected format. Nothing was written.
store.err.write = Not finished: could not write to the card.
store.err.interrupted = The last installation was interrupted. Try again.
store.err.unknown = Not finished.
store.portmaster.desc = Hundreds of adapted PC games (ports) such as Stardew Valley, Celeste, Half-Life and Cave Story. Once installed, open Ports › Portmaster to pick and install ports; they show up in the same Ports list. Some need files from a purchased copy of the game. This is "MinUI PortMaster", which bundles everything PortMaster needs.
store.grout.desc = RomM client: downloads games, saves and covers from your RomM server (romm.app) straight to the card. Needs your own RomM server, on your network or online.
emu.portmaster.note = Opens PortMaster and the ports it installed. Experimental on this device.

# N64 and Dreamcast
emu.mupen64.note = Nintendo 64 with dynarec and GLideN64 video (GLES 3). Light games run well; heavier ones may slow down. Use the Safe performance profile.
emu.flycast.note = Dreamcast. Works without BIOS (HLE mode), but dc_boot.bin and dc_flash.bin in Bios/dc improve compatibility. Heavy games may slow down.
video.res.n64default = Default (640×480)
video.res.native_light = Original (lighter)
video.res.1_5x = 1.5x
video.res.desc.3d = Draws the 3D graphics with more pixels: sharper, but much heavier on this CPU. If the game slows down, go back to the lighter option.

# ---- Tools (0.5.0)
apps.header = INSTALLED APPS
tools.header = TRIMUX TOOLS
tools.stats = Play statistics
tools.stats.desc = How long you played: total, your most played games and the time per platform. Counts sessions longer than 10 s, recorded on the device.
tools.random = Surprise game
tools.random.desc = Picks a random game, preferably one you never opened, and shows it in the list. Press again for another one.
tools.random.new = How about this one? You have not played it yet.
tools.random.any = How about this one? You have played them all, so any goes.
tools.files = File manager
tools.files.desc = Browse the card's folders, see size and date and delete files after confirming. TriMux's and the official system's folders are read-only.
tools.web = Files in the browser
tools.web.desc = Shows the card's files in the browser of a computer or phone on the same Wi-Fi: download, upload games and BIOS, create folders and delete files, without removing the card or installing anything. Works only while the window is open.
tools.clean = Card cleanup
tools.clean.desc = Looks for files that are useless on the device: those macOS and Windows create when copying (._file, .DS_Store, Thumbs.db), old logs and leftovers of interrupted installs. Shows what it found and deletes only after you confirm.

stats.none = No games played yet
stats.none.desc = Play time is counted since version 0.4.7, for every session longer than 10 s.
stats.total = Total time
stats.total.desc = All sessions longer than 10 s since version 0.4.7, of games still on the card.
stats.sessions = Sessions
stats.games = Different games
stats.last = Last game
stats.last.desc = %s (%s)\nLast played on %s.\n\nA: game options.
stats.top = MOST PLAYED
stats.game.desc = %s (%s)\nOpened %ld times, %s in total.\n\nA: game options.
stats.systems = BY PLATFORM
stats.system.desc = %s: %d games, %ld sessions, %d%% of your play time.

clean.intro = What was found
clean.intro.desc = Choose with A what to clean, then use Clean now. Games, saves, save states, BIOS, covers and settings are never deleted by this page.
clean.computer = Computer files
clean.computer.desc = Files macOS (._file, .DS_Store, .Trashes, .Spotlight-V100) and Windows (Thumbs.db) create when copying to the card. They are useless on the device and sometimes show up as fake games in other systems.
clean.logs = Old logs
clean.logs.desc = The previous TriMux log (trimux.log.1), the RetroArch log and the performance logs. The current log stays.
clean.temp = Install leftovers
clean.temp.desc = Files of an update or app install that was interrupted (.trimux-new, .trimux-store-new). The previous version kept for rollback (TriMux.old) is never deleted.
clean.nothing = nothing
clean.found = %d files, %s:
clean.run = Clean now
clean.run.desc = Deletes the %d selected files (%s), after confirming.
clean.rescan = Search again
clean.rescan.desc = Searches again, for example after copying files from a computer.
clean.confirm = Delete %ld files (%s)? This cannot be undone.\n\nGames, saves, BIOS, covers and settings are not touched.
clean.done = %d files deleted, %s freed

files.empty = Empty folder
files.desc = A: open the folder or delete the file · B: up one folder
files.unreadable = This folder could not be opened
files.prev = ‹ Previous page
files.next = Next page › (%ld more)
