wifi.sec.open = Aberta
wifi.sec.psk = Senha
wifi.sec.saved = Salva
wifi.sec.unsupported = Não suportada
wifi.ap.desc = Rede protegida por senha (WPA/WPA2). A para digitar a senha.
wifi.open.desc = Rede aberta, sem senha: qualquer pessoa por perto pode ver o tráfego.
wifi.current.desc = Rede atual. Esqueça a rede em Redes salvas, se quiser.
wifi.saved_ap.desc = Rede salva: A para conectar sem digitar a senha.
wifi.unsupported.desc = Este tipo de rede (empresarial, WEP ou só WPA3) não é suportado pelo TriMux. Use uma rede WPA2.
wifi.already = Você já está conectado a esta rede.
wifi.password_for = Senha de %s
