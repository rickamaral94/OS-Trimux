emu.portmaster.note = Abre o PortMaster e os ports instalados por ele. Experimental neste aparelho.

# N64 e Dreamcast
emu.mupen64.note = Nintendo 64 com recompilador e vídeo GLideN64 (GLES 3). Jogos leves rodam bem; os mais pesados podem ficar lentos. Use o perfil Desempenho seguro.
emu.flycast.note = Dreamcast. Funciona sem BIOS (modo HLE), mas dc_boot.bin e dc_flash.bin em Bios/dc melhoram a compatibilidade. Jogos pesados podem ficar lentos.
video.res.n64default = Padrão (640×480)
video.res.native_light = Original (mais leve)
video.res.1_5x = 1,5x
video.res.desc.3d = Desenha os gráficos 3D com mais pixels: fica mais nítido, mas pesa bem mais neste processador. Se o jogo ficar lento, volte para a opção mais leve.

# ---- Ferramentas (0.5.0)
apps.header = APLICATIVOS INSTALADOS
tools.header = FERRAMENTAS DO TRIMUX
tools.stats = Estatísticas de jogo
tools.stats.desc = Quanto tempo você jogou: total, os jogos mais jogados e o tempo por plataforma. Conta as sessões de mais de 10 s, gravadas no próprio aparelho.
tools.random = Jogo surpresa
tools.random.desc = Escolhe um jogo ao acaso, de preferência um que você nunca abriu, e mostra ele na lista. Aperte de novo para sortear outro.
tools.random.new = Que tal este? Você ainda não jogou.
tools.random.any = Que tal este? Você já jogou todos, então vale qualquer um.
tools.files = Gerenciador de arquivos
tools.files.desc = Navega pelas pastas do cartão, mostra tamanho e data e apaga arquivos com confirmação. As pastas do TriMux e do sistema oficial ficam somente leitura.
tools.web = Arquivos pelo navegador
tools.web.desc = Mostra os arquivos do cartão no navegador do computador ou do celular, na mesma rede Wi-Fi: baixe, envie jogos e BIOS, crie pastas e apague arquivos, sem tirar o cartão e sem instalar nada. Funciona só enquanto a janela estiver aberta.
tools.clean = Limpeza do cartão
tools.clean.desc = Procura arquivos que não servem para nada no aparelho: os que o macOS e o Windows criam ao copiar (._arquivo, .DS_Store, Thumbs.db), registros antigos e restos de instalações interrompidas. Mostra o que achou e só apaga depois da sua confirmação.

stats.none = Nenhum jogo jogado ainda
stats.none.desc = O tempo de jogo começa a contar a partir da versão 0.4.7, em cada sessão de mais de 10 s.
stats.total = Tempo total
stats.total.desc = Somando todas as sessões de mais de 10 s desde a versão 0.4.7, dos jogos que ainda estão no cartão.
stats.sessions = Sessões
stats.games = Jogos diferentes
stats.last = Último jogo
stats.last.desc = %s (%s)\nJogado pela última vez em %s.\n\nA: opções do jogo.
stats.top = MAIS JOGADOS
stats.game.desc = %s (%s)\nAberto %ld vezes, %s no total.\n\nA: opções do jogo.
stats.systems = POR PLATAFORMA
stats.system.desc = %s: %d jogos, %ld sessões, %d%% do seu tempo de jogo.

clean.intro = O que foi encontrado
clean.intro.desc = Escolha com A o que limpar e depois use Limpar agora. Jogos, saves, estados salvos, BIOS, capas e configurações nunca são apagados por esta tela.
clean.computer = Arquivos do computador
clean.computer.desc = Arquivos que o macOS (._arquivo, .DS_Store, .Trashes, .Spotlight-V100) e o Windows (Thumbs.db) criam ao copiar para o cartão. Não servem para nada no aparelho e às vezes aparecem como jogos falsos em outros sistemas.
clean.logs = Registros antigos
clean.logs.desc = O registro anterior do TriMux (trimux.log.1), o registro do RetroArch e os registros de desempenho. O registro atual fica.
clean.temp = Restos de instalações
clean.temp.desc = Arquivos de uma atualização ou instalação de aplicativo que foi interrompida (.trimux-new, .trimux-store-new). A versão anterior guardada para voltar atrás (TriMux.old) nunca é apagada.
clean.nothing = nada
clean.found = %d arquivos, %s:
clean.run = Limpar agora
clean.run.desc = Apaga os %d arquivos marcados (%s), depois de confirmar.
clean.rescan = Procurar de novo
clean.rescan.desc = Refaz a busca, por exemplo depois de copiar arquivos pelo computador.
clean.confirm = Apagar %ld arquivos (%s)? Isso não pode ser desfeito.\n\nJogos, saves, BIOS, capas e configurações não são tocados.
clean.done = %d arquivos apagados, %s liberados

files.empty = Pasta vazia
files.desc = A: entrar na pasta ou apagar o arquivo · B: voltar uma pasta
files.unreadable = Não foi possível abrir esta pasta
files.prev = ‹ Página anterior
files.next = Próxima página › (mais %ld)
files.dir.desc = Pasta %s\nModificada em %s\n\nA: abrir · B: voltar uma pasta
files.file.desc = %s\nTamanho: %s\nModificado em %s
files.delete.hint = A: apagar (pede confirmação) · B: voltar uma pasta
files.protected = Pasta do TriMux ou do sistema oficial: somente leitura, para não estragar o sistema.
files.delete = Apagar arquivo
files.delete.confirm = Apagar "%s" (%s)? Isso não pode ser desfeito.
files.deleted = Arquivo apagado
files.delete.failed = Não foi possível apagar o arquivo

web.needs_wifi = Conecte o Wi-Fi primeiro (Configurações › Rede).
web.failed = Não foi possível iniciar o servidor de arquivos. Veja o Registro.
web.running = No computador ou no celular, na mesma rede Wi-Fi, abra no navegador:\n\nhttp://%s:%d\n\nSem senha: qualquer aparelho desta rede pode ver e mudar os arquivos enquanto esta janela estiver aberta. O aparelho não desliga sozinho enquanto ela estiver aberta.\n\nA ou B: fechar e desligar o servidor.
emu.ppsspp.note = PlayStation Portable. Não precisa de BIOS: as fontes e arquivos do sistema do PSP vêm com o TriMux (Bios/PPSSPP). Jogos em .iso, .cso, .chd ou .pbp (os .cso ocupam menos espaço). Jogos 2D e leves rodam bem; os 3D pesados podem ficar lentos com a resolução 2x.
covers.systems = PLATAFORMAS PARA BAIXAR
covers.system.desc = %s: %zu jogos.\n\nA: ligar ou desligar. As plataformas desligadas ficam de fora do download de capas (manual e automático), para baixar primeiro só o que você quer. As capas já baixadas continuam aparecendo.
covers.waiting = %d de %d: esperando o Wi-Fi voltar…
