diag.viewlog = Ver log do TriMux
diag.session.desc = Emulador: %s. Perfil: %s. CPU média %s (máx. %s). Temperatura: %s no início, máx. %s, %s no fim. Bateria: %s → %s%s. Proteção térmica acionada %d vez(es).
diag.charging = carregando
diag.technical = Logs técnicos
diag.verbose = Log detalhado do TriMux
diag.verbose.desc = Registra mais detalhes em TriMuxData/logs/trimux.log (limitado a 256 KB + 1 cópia). Ligue só para investigar um problema.
diag.ralog = Log do RetroArch
diag.ralog.desc = O RetroArch grava o próprio log em TriMuxData/logs/retroarch/retroarch.log, substituído a cada jogo. Ajuda a entender um jogo que não abre ou fecha sozinho.
diag.clear = Apagar registros de desempenho
diag.clear.desc = Apaga as sessões gravadas e o log do RetroArch. Não mexe em jogos, saves nem configurações.
diag.clear.confirm = Apagar todas as sessões gravadas e o log do RetroArch?
diag.cleared = %d arquivos apagados

